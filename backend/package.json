{
  "name": "@reachinbox/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "node scripts/with-env.mjs prisma generate",
    "prisma:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "prisma:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "prisma:push": "node scripts/with-env.mjs prisma db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.0",
    "@bull-board/express": "^6.7.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@prisma/client": "^6.3.1",
    "bullmq": "^5.37.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
