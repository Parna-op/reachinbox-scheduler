# ==========================================
# Infrastructure
# ==========================================
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_pass
POSTGRES_DB=reachinbox
POSTGRES_PORT=5432
DATABASE_URL="postgresql://reachinbox:reachinbox_pass@localhost:5432/reachinbox?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="reachinbox_emails"

# ==========================================
# Server & Frontend URLs
# ==========================================
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ==========================================
# Auth & Session (JWT Cookie)
# ==========================================
JWT_SECRET="replace-with-a-strong-64-char-random-secret"
SESSION_COOKIE_NAME="reachinbox_session"
SESSION_TTL_SECONDS=604800

# ==========================================
# Google OAuth 2.0
# ==========================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ==========================================
# Slack OAuth 2.0
# ==========================================
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_REDIRECT_URI="http://localhost:4000/api/slack/callback"

# ==========================================
# BullMQ Worker & Rate Limiting
# ==========================================
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100
EMAIL_QUEUE_NAME="email-dispatch-queue"
RUN_EMBEDDED_WORKER=false

# ==========================================
# Optional Pre-configured Ethereal SMTP Account
# (If omitted, Ethereal accounts can be auto-provisioned via API/UI)
# ==========================================
ETHEREAL_USER=""
ETHEREAL_PASS=""
ETHEREAL_FROM_NAME="ReachInbox Outreach"
